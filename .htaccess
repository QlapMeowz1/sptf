RewriteOptions inherit

<IfModule mod_rewrite.c>
    Options -Indexes
    RewriteEngine On
    RewriteBase /

    # Force non-www
    RewriteCond %{HTTP_HOST} ^www\.melmuop\.site$ [NC]
    RewriteRule ^ https://melmuop.site%{REQUEST_URI} [R=301,L]

    # Force HTTPS (Cloudflare-aware, avoid loop when proxying)
    RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
    RewriteCond %{HTTP:CF-Visitor} !"\"scheme\":\"https\"" [NC]
    RewriteCond %{HTTPS} off
    RewriteRule ^ https://melmuop.site%{REQUEST_URI} [R=301,L]

    # Block bad bots
    RewriteCond %{HTTP_USER_AGENT} (almaden|Anarchie|ASPSeek|attach|autoemailspider|BackWeb|Bandit|BlackWidow|Bot|Buddy|bumblebee|CherryPicker|ChinaClaw|Collector|Copier|Custo|DA|DIIbot|DISCo|Download|Downloader|Drip|EirGrabber|EmailCollector|EmailSiphon|EmailWolf|ExtractorPro|FlashGet|FrontPage|GetRight|GetWeb|Go!Zilla|Grabber|HTTrack|Indy|larbin|LeechFTP|LexiBot|Mass|Microsoft.URL|MSFrontPage|NetAnts|Offline|PageGrabber|pavuk|psbot|RealDownload|Reaper|SiteSnagger|SmartDownload|SuperBot|Teleport|WebCopier|WebZIP|Wget|Zeus) [NC]
    RewriteRule ^ - [F,L]

    # Error Pages
    ErrorDocument 404 /res/error/404.html
    ErrorDocument 403 /res/error/403.html
    ErrorDocument 504 /res/error/504.html

    # System Rewrite
    RewriteRule ^404/?$ 404.html [L]
    RewriteRule ^403/?$ 403.html [L]
    RewriteRule ^504/?$ 504.html [L]

</IfModule>
